         <property name="styleSheet">
          <string notr="true">QWidget#tab_4 {
    color: #202124;
    background-color: transparent;
}
QFrame#tools_editor_card,
QFrame#tools_linear_card,
QFrame#tools_nonlinear_card {
    background-color: rgba(250,250,250,0.45);
    border: 1px solid #dddddf;
    border-radius: 9px;
}
QFrame#tools_editor_card {
    border-top: 4px solid #0ea5e9;
}
QFrame#tools_linear_card {
    border-top: 4px solid #10b981;
}
QFrame#tools_nonlinear_card {
    border-top: 4px solid #f59e0b;
}
QLabel#tools_editor_title,
QLabel#tools_linear_title,
QLabel#tools_nonlinear_title {
    font-size: 10pt;
    font-weight: bold;
}
QWidget#tab_4 QPushButton {
    color: #202124;
    background-color: #ffffff;
    border: 1px solid #d9d9dc;
    border-radius: 6px;
    padding: 6px 9px;
    min-height: 28px;
    text-align: left;
}
QWidget#tab_4 QPushButton:hover {
    background-color: #eeeeef;
    border-color: #c5c5c9;
}
QWidget#tab_4 QPushButton:pressed {
    background-color: #e2e2e4;
}
QWidget#tab_4 QPushButton#view_image,
QWidget#tab_4 QPushButton#linear_reg,
QWidget#tab_4 QPushButton#nonlinear_reg {
    color: #ffffff;
    font-weight: bold;
    text-align: center;
}
QWidget#tab_4 QPushButton#view_image {
    background-color: #0ea5e9;
    border-color: #0ea5e9;
}
QWidget#tab_4 QPushButton#linear_reg {
    background-color: #10b981;
    border-color: #10b981;
}
QWidget#tab_4 QPushButton#nonlinear_reg {
    background-color: #f59e0b;
    border-color: #f59e0b;
}
QWidget#tab_4 QComboBox {
    color: #202124;
    background-color: #ffffff;
    border: 1px solid #d9d9dc;
    border-radius: 6px;
    padding: 5px 8px;
    min-height: 28px;
}
QLabel#tools_page_hint,
QLabel#tools_editor_hint,
QLabel#tools_linear_hint,
QLabel#tools_nonlinear_hint {
    color: #67676c;
}
QFrame#tools_recent_card {
    background-color: rgba(247,247,248,0.45);
    border: 1px solid #dddddf;
    border-radius: 9px;
}
