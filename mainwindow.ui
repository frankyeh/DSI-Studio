    background-color: #f59e0b;
    border-color: #f59e0b;
    text-align: center;
}
QFrame#tract_input_stage QPushButton#tract_input_batch_toggle,
QFrame#tract_input_stage QPushButton#tract_nifti_qc_toggle,
QFrame#tract_reconstruction_stage QPushButton#tract_reconstruction_batch_toggle,
