        <widget class="QWidget" name="tab_conn">
         <property name="styleSheet">
          <string notr="true">QWidget#tab_conn {
    color: #202124;
    background-color: transparent;
}
QWidget#tab_conn QLabel {
    background-color: transparent;
}
QFrame#conn_import_stage,
QFrame#conn_db_stage,
QFrame#conn_analysis_stage {
    background-color: rgba(250,250,250,0.45);
    border: 1px solid #dddddf;
    border-radius: 9px;
}
QFrame#conn_import_stage {
    border-top: 4px solid #0ea5e9;
}
QFrame#conn_db_stage {
    border-top: 4px solid #8b5cf6;
}
QFrame#conn_analysis_stage {
    border-top: 4px solid #ef4444;
}
QWidget#tab_conn QPushButton {
    color: #202124;
    background-color: #ffffff;
    border: 1px solid #d9d9dc;
    border-radius: 7px;
    padding: 5px 8px;
    min-height: 32px;
    text-align: left;
}
QFrame#conn_import_stage QPushButton#conn_import_more_toggle {
    color: #2563eb;
    background-color: transparent;
    border: 0px;
    min-height: 0px;
    padding: 2px 0px;
    font-weight: bold;
}
QFrame#conn_import_more {
    background-color: transparent;
    border: 0px;
}
QWidget#tab_conn QPushButton:hover {
    background-color: #f1f1f3;
    border-color: #bfc0c4;
}
QWidget#tab_conn QPushButton#conn_fib_files,
QWidget#tab_conn QPushButton#conn_fib_folder {
    color: #ffffff;
    background-color: #0ea5e9;
    border-color: #0ea5e9;
    font-weight: bold;
    text-align: center;
}
QWidget#tab_conn QPushButton#open_db {
    color: #ffffff;
    background-color: #8b5cf6;
    border-color: #8b5cf6;
    text-align: center;
}
QWidget#tab_conn QPushButton#group_connectometry {
    color: #ffffff;
    background-color: #ef4444;
    border-color: #ef4444;
    font-weight: bold;
    text-align: center;
}
QLabel#tract_connectometry_title {
    font-size: 11pt;
    font-weight: bold;
}
QLabel#conn_import_stage_title,
QLabel#conn_db_stage_title,
QLabel#conn_analysis_stage_title {
    font-size: 10pt;
    font-weight: bold;
}
QLabel#conn_import_stage_hint,
QLabel#conn_db_stage_hint,
QLabel#conn_analysis_stage_hint {
    color: #67676c;
}
QWidget#tab_conn QLabel#conn_import_badge,
QWidget#tab_conn QLabel#conn_db_badge,
QWidget#tab_conn QLabel#conn_analysis_badge {
    color: #ffffff;
    border-radius: 13px;
    font-weight: bold;
    font-size: 10pt;
}
QWidget#tab_conn QLabel#conn_import_badge {
    background-color: #0ea5e9;
}
QWidget#tab_conn QLabel#conn_db_badge {
    background-color: #8b5cf6;
}
QWidget#tab_conn QLabel#conn_analysis_badge {
    background-color: #ef4444;
}
QFrame#conn_recent_card {
    background-color: rgba(247,247,248,0.45);
    border: 1px solid #dddddf;
    border-radius: 9px;
}
QFrame#conn_recent_card QPushButton {
    color: #202124;
    background-color: #f4f4f5;
    border: 1px solid #d9d9dc;
    border-radius: 7px;
    padding: 5px 9px;
    min-height: 0px;
    text-align: center;
}
QFrame#conn_recent_card QPushButton:hover {
    background-color: #e9e9eb;
    border-color: #c8c8cc;
}
QFrame#conn_recent_card QPushButton:pressed {
    background-color: #dddddf;
}
QFrame#conn_recent_card QPushButton[segment="true"] {
    color: #1e3a8a;
    background-color: #e0e7ff;
    border: 1px solid #a5b4fc;
    border-radius: 11px;
    padding: 2px 10px;
    min-height: 20px;
}
QTableWidget#recentDb {
    color: #202124;
    background-color: transparent;
    alternate-background-color: rgba(0,0,0,0.025);
    border: 1px solid #d9d9dc;
    border-radius: 7px;
    selection-background-color: #e5e5e7;
    selection-color: #202124;
}
QTableWidget#recentDb QHeaderView::section {
    color: #4f4f54;
    background-color: rgba(244,244,245,0.6);
    border: 0px;
    border-right: 1px solid #e2e2e5;
    border-bottom: 1px solid #d9d9dc;
    padding: 2px 5px;
    font-weight: bold;
}
QLabel#conn_arrow_1,
QLabel#conn_arrow_2 {
    color: #9aa3ad;
    background-color: transparent;
    font-size: 18pt;
    font-weight: bold;
    min-width: 22px;
    min-height: 22px;
}</string>
