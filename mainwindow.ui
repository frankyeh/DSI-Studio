    background-color: transparent;
    border: 0px;
    min-height: 0px;
    padding: 2px 0px;
    font-weight: bold;
}
QWidget#tab QPushButton[segment="true"] {
    color: #4f4f54;
    background-color: #f1f3f6;
    border: 1px solid #dfe3e8;
    border-radius: 11px;
    padding: 2px 10px;
    min-height: 20px;
    text-align: center;
}
QWidget#tab QPushButton[segment="true"]:hover {
    background-color: #e6e9ef;
}
QWidget#tab QPushButton[segment="true"]:checked {
    color: #1e3a8a;
    background-color: #e0e7ff;
    border-color: #a5b4fc;
}
QLabel#tract_input_badge,
QLabel#tract_reconstruction_badge,
QLabel#tract_tracking_badge {
    color: #ffffff;
    border-radius: 13px;
    font-weight: bold;
