    color: #202124;
    background-color: #f4f4f5;
    border: 1px solid #d9d9dc;
    border-radius: 7px;
    padding: 5px 9px;
    min-height: 0px;
    text-align: center;
}
QFrame#tools_recent_card QPushButton:hover {
    background-color: #e9e9eb;
    border-color: #c8c8cc;
}
QFrame#tools_recent_card QPushButton:pressed {
    background-color: #dddddf;
}
QFrame#tools_recent_card QPushButton[segment="true"] {
    color: #1e3a8a;
    background-color: #e0e7ff;
    border: 1px solid #a5b4fc;
    border-radius: 11px;
    padding: 2px 10px;
    min-height: 20px;
}
QTableWidget#recentImage {
    color: #202124;
    background-color: transparent;
    alternate-background-color: rgba(0,0,0,0.025);
    border: 1px solid #d9d9dc;
    border-radius: 7px;
    selection-background-color: #e5e5e7;
    selection-color: #202124;
}
QTableWidget#recentImage QHeaderView::section {
    color: #4f4f54;
    background-color: rgba(244,244,245,0.6);
    border: 0px;
    border-right: 1px solid #e2e2e5;
    border-bottom: 1px solid #d9d9dc;
    padding: 2px 5px;
    font-weight: bold;
}</string>
