}
QLabel#tract_tracking_badge {
    background-color: #f59e0b;
}
QLabel#tract_arrow_1,
QLabel#tract_arrow_2 {
    color: #9aa3ad;
    background-color: transparent;
    font-size: 18pt;
    font-weight: bold;
    min-width: 22px;
    min-height: 22px;
}</string>
