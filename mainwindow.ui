      <widget class="QWidget" name="tab">
       <property name="styleSheet">
        <string notr="true">QWidget#tab {
    color: #202124;
    background-color: #ffffff;
}
QFrame#tract_recent_panel {
    background-color: #f7f7f8;
    border: 1px solid #dddddf;
    border-radius: 9px;
}
QLabel#recent_files_title,
QLabel#label_2,
QLabel#label_3 {
    background-color: transparent;
}
QFrame#recent_src_card,
QFrame#recent_fib_card,
QFrame#tract_input_stage,
QFrame#tract_reconstruction_stage,
QFrame#tract_tracking_stage,
QFrame#tract_template_stage,
QFrame#tract_connectometry_stage {
    background-color: #fafafa;
    border: 1px solid #dddddf;
    border-radius: 9px;
}
QWidget#tab QPushButton {
    color: #202124;
    background-color: #f4f4f5;
    border: 1px solid #d9d9dc;
    border-radius: 7px;
    padding: 5px 9px;
}
QWidget#tab QPushButton:hover {
    background-color: #e9e9eb;
    border-color: #c8c8cc;
}
QWidget#tab QPushButton:pressed {
    background-color: #dddddf;
}
QWidget#tab QPushButton:disabled {
    color: #9a9a9f;
    background-color: #eeeeef;
}
QFrame#tract_input_stage QPushButton,
QFrame#tract_reconstruction_stage QPushButton,
QFrame#tract_tracking_stage QPushButton,
QFrame#tract_template_stage QPushButton,
QFrame#tract_connectometry_stage QPushButton {
    color: #202124;
    background-color: #ffffff;
    border: 1px solid #d9d9dc;
    border-radius: 7px;
    padding: 5px 8px;
    min-height: 32px;
    min-width: 0px;
    text-align: left;
}
QPushButton#OpenDWI_NIFTI,
QPushButton#OpenDWI_DICOM,
QPushButton#Reconstruction,
QPushButton#FiberTracking {
    font-weight: bold;
}
QFrame#tract_input_stage QPushButton:hover,
QFrame#tract_reconstruction_stage QPushButton:hover,
QFrame#tract_tracking_stage QPushButton:hover,
QFrame#tract_template_stage QPushButton:hover,
QFrame#tract_connectometry_stage QPushButton:hover {
    background-color: #f1f1f3;
    border-color: #bfc0c4;
}
QFrame#tract_input_stage QPushButton:pressed,
QFrame#tract_reconstruction_stage QPushButton:pressed,
QFrame#tract_tracking_stage QPushButton:pressed,
QFrame#tract_template_stage QPushButton:pressed,
QFrame#tract_connectometry_stage QPushButton:pressed {
    background-color: #e5e5e7;
}
QWidget#tab QTableWidget,
QListWidget#template_list {
    color: #202124;
    background-color: #ffffff;
    alternate-background-color: #fafafa;
    border: 1px solid #d9d9dc;
    border-radius: 7px;
    gridline-color: #eeeeef;
    selection-background-color: #e5e5e7;
    selection-color: #202124;
}
QWidget#tab QHeaderView::section {
    color: #4f4f54;
    background-color: #f4f4f5;
    border: 0px;
    border-right: 1px solid #e2e2e5;
    border-bottom: 1px solid #d9d9dc;
    padding: 2px 5px;
    font-weight: bold;
}
QListWidget#template_list::item {
    margin: 3px;
    padding: 7px 12px;
    border-radius: 6px;
}
QListWidget#template_list::item:selected {
    background-color: #e5e5e7;
}
QLabel#tract_workflow_title {
    font-size: 11pt;
    font-weight: bold;
}
QLabel#label_45,
QLabel#label_17,
QLabel#label_28,
QLabel#tract_connectometry_title {
    font-size: 10pt;
    font-weight: bold;
}
QLabel#tract_workflow_hint,
QLabel#tract_input_hint,
QLabel#tract_reconstruction_hint,
QLabel#tract_tracking_hint,
QLabel#tract_connectometry_hint,
QLabel#tract_direct_header,
QLabel#tract_dicom_header,
QLabel#tract_batch_header {
    color: #67676c;
}
QWidget#tab QScrollBar:vertical {
    background-color: transparent;
    border: 0px;
    width: 10px;
    margin: 2px;
}
QWidget#tab QScrollBar:horizontal {
    background-color: transparent;
    border: 0px;
    height: 10px;
    margin: 2px;
}
QWidget#tab QScrollBar::handle {
    background-color: #c7c7cc;
    border: 0px;
    border-radius: 4px;
    min-height: 24px;
    min-width: 24px;
}
QWidget#tab QScrollBar::handle:hover {
    background-color: #a9a9af;
}
QWidget#tab QScrollBar::add-line,
QWidget#tab QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}
QWidget#tab QScrollBar::add-page,
QWidget#tab QScrollBar::sub-page {
    background-color: transparent;
}</string>
