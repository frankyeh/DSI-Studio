        <widget class="QWidget" name="tab_conn">
         <property name="styleSheet">
          <string notr="true">QWidget#tab_conn {
    color: #202124;
    background-color: #ffffff;
}
QFrame#tract_connectometry_stage {
    background-color: #fafafa;
    border: 1px solid #dddddf;
    border-top: 4px solid #ef4444;
    border-radius: 9px;
}
QWidget#tab_conn QLabel {
    background-color: transparent;
}
QWidget#tab_conn QPushButton {
    color: #202124;
    background-color: #ffffff;
    border: 1px solid #d9d9dc;
    border-radius: 7px;
    padding: 5px 9px;
    min-height: 34px;
    text-align: left;
}
QWidget#tab_conn QPushButton:hover {
    background-color: #f1f1f3;
    border-color: #bfc0c4;
}
QWidget#tab_conn QPushButton#group_connectometry {
    color: #ffffff;
    background-color: #ef4444;
    border-color: #ef4444;
    font-weight: bold;
}
QWidget#tab_conn QPushButton#group_connectometry:hover {
    background-color: #dc2626;
}
QLabel#tract_connectometry_title {
    font-size: 11pt;
    font-weight: bold;
}
QLabel#tract_connectometry_hint {
    color: #67676c;
}</string>
         </property>
         <layout class="QVBoxLayout" name="tab_conn_layout">
          <property name="spacing">
           <number>9</number>
          </property>
          <property name="leftMargin">
           <number>12</number>
          </property>
          <property name="topMargin">
           <number>12</number>
          </property>
          <property name="rightMargin">
           <number>12</number>
          </property>
          <property name="bottomMargin">
           <number>12</number>
          </property>
          <item>
           <widget class="QFrame" name="tract_connectometry_stage">
            <layout class="QVBoxLayout" name="tract_connectometry_layout">
             <property name="spacing">
              <number>5</number>
             </property>
             <property name="leftMargin">
              <number>8</number>
             </property>
             <property name="topMargin">
              <number>7</number>
             </property>
             <property name="rightMargin">
              <number>8</number>
             </property>
             <property name="bottomMargin">
              <number>8</number>
             </property>
             <item>
              <layout class="QHBoxLayout" name="tract_connectometry_header">
               <property name="spacing">
                <number>7</number>
               </property>
               <item>
                <widget class="QLabel" name="tract_connectometry_title">
                 <property name="text">
                  <string>Correlational Tractography</string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QLabel" name="tract_connectometry_hint">
                 <property name="text">
                  <string>FIB files (*.fz) → database (*.dz) → group analysis</string>
                 </property>
                 <property name="wordWrap">
                  <bool>true</bool>
                 </property>
                </widget>
               </item>
               <item>
                <spacer name="tract_connectometry_header_spacer">
                 <property name="orientation">
                  <enum>Qt::Horizontal</enum>
                 </property>
                 <property name="sizeHint" stdset="0">
                  <size>
                   <width>10</width>
                   <height>20</height>
                  </size>
                 </property>
                </spacer>
               </item>
              </layout>
             </item>
             <item>
              <layout class="QVBoxLayout" name="tract_connectometry_actions">
               <property name="spacing">
                <number>6</number>
               </property>
               <item>
                <widget class="QPushButton" name="vbc">
                 <property name="statusTip">
                  <string>run create_db</string>
                 </property>
                 <property name="toolTip">
                  <string>Aggregate FIB files into a database</string>
                 </property>
                 <property name="icon">
                  <iconset resource="icons.qrc">
                   <normaloff>:/icons/icons/open.xpm</normaloff>:/icons/icons/open.xpm</iconset>
                 </property>
                 <property name="text">
                  <string>1. Create database (.dz)</string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QPushButton" name="open_db">
                 <property name="statusTip">
                  <string>run open_db</string>
                 </property>
                 <property name="toolTip">
                  <string>Manage subjects and longitudinal changes</string>
                 </property>
                 <property name="icon">
                  <iconset resource="icons.qrc">
                   <normaloff>:/icons/icons/open.xpm</normaloff>:/icons/icons/open.xpm</iconset>
                 </property>
                 <property name="text">
                  <string>2. View / edit database</string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QPushButton" name="group_connectometry">
                 <property name="statusTip">
                  <string>run open_connectometry</string>
                 </property>
                 <property name="toolTip">
                  <string>Run correlational tractography and connectometry analysis</string>
                 </property>
                 <property name="icon">
                  <iconset resource="icons.qrc">
                   <normaloff>:/icons/icons/open.xpm</normaloff>:/icons/icons/open.xpm</iconset>
