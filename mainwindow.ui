       <property name="styleSheet">
        <string notr="true">QWidget#tab_8 {
    background-color: #ffffff;
}
QWidget#tab_8 QPushButton,
QWidget#tab_8 QToolButton {
    color: #202124;
    background-color: #f4f4f5;
    border: 1px solid #d9d9dc;
    border-radius: 7px;
    padding: 6px 10px;
}
QWidget#tab_8 QPushButton:hover,
QWidget#tab_8 QToolButton:hover {
    background-color: #e9e9eb;
    border-color: #c8c8cc;
}
QWidget#tab_8 QPushButton:pressed,
QWidget#tab_8 QToolButton:pressed {
    background-color: #dddddf;
}
QPushButton#ai_new_codex_chat,
QPushButton#ai_new_claude_chat {
    background-color: #ffffff;
    font-size: 9pt;
    font-weight: bold;
    padding: 8px;
}
QPushButton#ai_project_title,
QPushButton#ai_project_title:hover,
QPushButton#ai_project_title:pressed {
    background: transparent;
    border: 0;
    padding: 2px;
    text-align: left;
}
QToolButton#ai_project_menu_button {
    background: transparent;
    border: 0;
    padding: 0;
    font-weight: bold;
}
QToolButton#ai_project_menu_button:hover {
    background: #e2e2e4;
    border-radius: 4px;
}
QToolButton#ai_project_menu_button::menu-indicator {
    image: none;
}
QLineEdit#ai_project_filter {
    background-color: #ffffff;
    border: 1px solid #d9d9dc;
    border-radius: 7px;
    padding: 6px 8px;
}
QPushButton#ai_send_message {
    color: #ffffff;
    background-color: #2f2f2f;
    border-color: #2f2f2f;
}
QPushButton#ai_send_message:hover {
    background-color: #171717;
    border-color: #171717;
}
QPushButton#ai_send_message:pressed {
    background-color: #000000;
}
QTextBrowser#ai_chat_history QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QTextBrowser#ai_chat_history QScrollBar::handle:vertical {
    background: #c7c7ca;
    border: 0;
    border-radius: 4px;
    min-height: 24px;
}
QTextBrowser#ai_chat_history QScrollBar::handle:vertical:hover {
    background: #a9a9ad;
}
QTextBrowser#ai_chat_history QScrollBar::add-line:vertical,
QTextBrowser#ai_chat_history QScrollBar::sub-line:vertical {
    height: 0;
}
QTextBrowser#ai_chat_history QScrollBar::add-page:vertical,
QTextBrowser#ai_chat_history QScrollBar::sub-page:vertical {
    background: transparent;
}</string>
