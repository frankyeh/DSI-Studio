       <property name="styleSheet">
        <string notr="true">QWidget#tab_6 {
    color: #202124;
    background-color: #ffffff;
}
QWidget#tab_6 QPushButton {
    color: #202124;
    background-color: #f4f4f5;
    border: 1px solid #d9d9dc;
    border-radius: 7px;
    padding: 6px 10px;
}
QWidget#tab_6 QPushButton:hover {
    background-color: #e9e9eb;
    border-color: #c8c8cc;
}
QWidget#tab_6 QPushButton:pressed {
    background-color: #dddddf;
}
QWidget#tab_6 QComboBox,
QWidget#tab_6 QLineEdit {
    background-color: #ffffff;
    border: 1px solid #d9d9dc;
    border-radius: 7px;
    padding: 5px 8px;
}
QWidget#tab_6 QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 24px;
    background-color: transparent;
    border: 0px;
}
QWidget#tab_6 QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #fafafa;
    border: 1px solid #d9d9dc;
    border-radius: 7px;
    gridline-color: #ececef;
    selection-background-color: #e5e5e7;
    selection-color: #202124;
}
QWidget#tab_6 QHeaderView::section {
    color: #202124;
    background-color: #f4f4f5;
    border: 0px;
    border-right: 1px solid #e2e2e5;
    border-bottom: 1px solid #d9d9dc;
    padding: 2px 6px;
    font-weight: bold;
}
QTextBrowser#github_note {
    background-color: #ffffff;
    border: 1px solid #d9d9dc;
    border-radius: 7px;
    padding: 12px;
}
QWidget#tab_6 QTabWidget::pane {
    border: 1px solid #d9d9dc;
    border-radius: 7px;
}
QWidget#tab_6 QTabBar::tab {
    background-color: #f4f4f5;
    border: 1px solid #d9d9dc;
    border-bottom: 0px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 12px;
}
QWidget#tab_6 QTabBar::tab:selected {
    background-color: #ffffff;
}
QLabel#github_repo_title {
    color: #202124;
    font-size: 16px;
    font-weight: bold;
}
QPushButton#github_open_file,
QPushButton#github_download {
    color: #ffffff;
    background-color: #2f2f2f;
    border-color: #2f2f2f;
    font-weight: bold;
}
QPushButton#github_open_file:hover,
QPushButton#github_download:hover {
    background-color: #171717;
    border-color: #171717;
}
QWidget#tab_6 QPushButton:disabled {
    color: #8a8a8f;
    background-color: #ececef;
    border-color: #dddddf;
}
QWidget#tab_6 QScrollBar:vertical {
    background-color: transparent;
    border: 0px;
    width: 10px;
    margin: 2px;
}
QWidget#tab_6 QScrollBar:horizontal {
    background-color: transparent;
    border: 0px;
    height: 10px;
    margin: 2px;
}
QWidget#tab_6 QScrollBar::handle {
    background-color: #c7c7cc;
    border: 0px;
    border-radius: 4px;
}
QWidget#tab_6 QScrollBar::handle:vertical {
    min-height: 24px;
}
QWidget#tab_6 QScrollBar::handle:horizontal {
    min-width: 24px;
}
QWidget#tab_6 QScrollBar::handle:hover {
    background-color: #a9a9af;
}
QWidget#tab_6 QScrollBar::add-line:vertical,
QWidget#tab_6 QScrollBar::sub-line:vertical {
    height: 0px;
}
QWidget#tab_6 QScrollBar::add-line:horizontal,
QWidget#tab_6 QScrollBar::sub-line:horizontal {
    width: 0px;
}
QWidget#tab_6 QScrollBar::add-page,
QWidget#tab_6 QScrollBar::sub-page {
    background-color: transparent;
    border: 0px;
}</string>
