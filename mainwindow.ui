}
QFrame#tract_input_stage QPushButton#OpenDWI_NIFTI,
QFrame#tract_input_stage QPushButton#import_nifti_folder,
QFrame#tract_input_stage QPushButton#OpenDWI_DICOM,
QFrame#tract_input_stage QPushButton#dicom2nii,
QFrame#tract_input_stage QPushButton#OpenDWI_2dseq {
    color: #ffffff;
    background-color: #0ea5e9;
    border-color: #0ea5e9;
    font-weight: bold;
    text-align: center;
}
QFrame#tract_reconstruction_stage QPushButton#Reconstruction {
    color: #ffffff;
    background-color: #10b981;
    border-color: #10b981;
    text-align: center;
}
QFrame#tract_tracking_stage QPushButton#FiberTracking {
