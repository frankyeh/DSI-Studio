        <widget class="QWidget" name="tab_setup">
         <property name="styleSheet">
          <string notr="true">QWidget#tab_setup {
    color: #202124;
    background-color: #ffffff;
}
QWidget#tab_setup QGroupBox {
    background-color: #f7f7f8;
    border: 1px solid #dddddf;
    border-radius: 8px;
    margin-top: 9px;
}
QWidget#tab_setup QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0px 4px;
    font-weight: bold;
}
QWidget#tab_setup QPushButton,
QWidget#tab_setup QComboBox {
    color: #202124;
    background-color: #ffffff;
    border: 1px solid #d9d9dc;
    border-radius: 6px;
    padding: 5px 9px;
    min-height: 28px;
}</string>
