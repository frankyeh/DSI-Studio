        <widget class="QWidget" name="tab_4">
         <property name="styleSheet">
          <string notr="true">QWidget#tab_4 {
    color: #202124;
    background-color: #ffffff;
}
QFrame#tools_view_image_card,
QWidget#tab_4 QGroupBox {
    background-color: #f7f7f8;
    border: 1px solid #dddddf;
    border-radius: 8px;
}
QWidget#tab_4 QGroupBox {
    margin-top: 9px;
}
QWidget#tab_4 QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0px 4px;
    font-weight: bold;
}
QWidget#tab_4 QPushButton {
    color: #202124;
    background-color: #ffffff;
    border: 1px solid #d9d9dc;
    border-radius: 6px;
    padding: 6px 9px;
    min-height: 28px;
    text-align: left;
}
QWidget#tab_4 QPushButton:hover {
    background-color: #eeeeef;
    border-color: #c5c5c9;
}
QWidget#tab_4 QPushButton:pressed {
    background-color: #e2e2e4;
}
QPushButton#view_image {
    color: #ffffff;
    background-color: #2f2f2f;
    border-color: #2f2f2f;
    font-weight: bold;
    text-align: center;
    min-width: 150px;
}
QPushButton#view_image:hover {
    background-color: #171717;
    border-color: #171717;
}
QWidget#tab_4 QComboBox {
    color: #202124;
    background-color: #ffffff;
    border: 1px solid #d9d9dc;
    border-radius: 6px;
    padding: 5px 8px;
    min-height: 28px;
}
QLabel#tools_page_hint,
QLabel#tools_view_image_hint {
    color: #67676c;
}</string>
         </property>
