  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">QFrame#sidebar { background-color: #f1f3f6; border: 0px; border-right: 1px solid #e3e6ea; }
QListWidget#nav_rail { background-color: transparent; border: 0px; padding-top: 6px; outline: 0; }
QListWidget#nav_rail::item { color: #202124; margin: 2px 8px; padding: 7px 6px; border: 1px solid transparent; border-radius: 8px; }
QListWidget#nav_rail::item:hover { background-color: #e6e9ef; }
QListWidget#nav_rail::item:selected { color: #202124; background-color: #e0e7ff; border: 1px solid #c7d2fe; }
QLabel#method_hint { color: #67676c; }
QTableView#volume_list { border: 1px solid #dddddf; border-radius: 9px; background-color: #ffffff; alternate-background-color: #f7f7f8; font-size: 9pt; }
QTableView#volume_list::item:selected { color: #202124; background-color: #e0e7ff; }
QFrame#run_bar { background-color: #f7f7f8; border: 0px; border-top: 1px solid #e3e6ea; }
QScrollArea#recon_scroll, QWidget#recon_content, QScrollArea#inspect_scroll, QWidget#inspect_content, QScrollArea#options_scroll, QWidget#options_content { background-color: transparent; }
QStackedWidget#pages QPushButton { color: #202124; background-color: #ffffff; border: 1px solid #d9d9dc; border-radius: 7px; padding: 5px 9px; min-height: 26px; }
QStackedWidget#pages QPushButton:hover { background-color: #f1f1f3; border-color: #bfc0c4; }
QStackedWidget#pages QPushButton:pressed { background-color: #e5e5e7; }
QStackedWidget#pages QPushButton:focus { border-color: #a5b4fc; }
QStackedWidget#pages QPushButton:disabled { color: #9a9a9f; background-color: #eeeeef; border-color: #e3e3e6; }
QWidget#mask_edit QPushButton, QFrame#image_group QPushButton, QFrame#signal_group QPushButton, QFrame#correction_group QPushButton, QFrame#btable_orient_group QPushButton { background-color: #f4f4f5; min-height: 22px; }
QWidget#mask_edit QPushButton:hover, QFrame#image_group QPushButton:hover, QFrame#signal_group QPushButton:hover, QFrame#correction_group QPushButton:hover, QFrame#btable_orient_group QPushButton:hover { background-color: #e9e9eb; border-color: #c8c8cc; }
QStackedWidget#pages QPushButton#from_template, QStackedWidget#pages QPushButton#from_unet, QStackedWidget#pages QPushButton#load_mask, QStackedWidget#pages QPushButton#save_mask { font-weight: bold; }
QStackedWidget#pages QPushButton#edit_mask, QStackedWidget#pages QPushButton#more_outputs { color: #2563eb; background-color: transparent; border: 0px; min-height: 0px; padding: 2px 0px; font-weight: bold; }
QStackedWidget#pages QPushButton#edit_mask:hover, QStackedWidget#pages QPushButton#more_outputs:hover { color: #1e40af; }
QFrame#run_bar QPushButton#doDTI { color: #ffffff; background-color: #10b981; border: 1px solid #10b981; border-radius: 9px; padding: 8px 18px; min-height: 30px; font-weight: bold; }
QFrame#run_bar QPushButton#doDTI:hover { background-color: #059669; border-color: #059669; }
QFrame#run_bar QPushButton#doDTI:pressed { background-color: #047857; }
QFrame#run_bar QPushButton#doDTI:disabled { color: #ecfdf5; background-color: #a7e3cf; border-color: #a7e3cf; }
QRadioButton#DTI, QRadioButton#GQI, QRadioButton#QSDR { color: #4f4f54; background-color: #f1f3f6; border: 1px solid #dfe3e8; border-radius: 15px; padding: 6px 20px; min-height: 18px; font-weight: bold; }
QRadioButton#DTI::indicator, QRadioButton#GQI::indicator, QRadioButton#QSDR::indicator { width: 0px; height: 0px; }
QRadioButton#DTI:hover, QRadioButton#GQI:hover, QRadioButton#QSDR:hover { background-color: #e6e9ef; }
QRadioButton#DTI:focus, QRadioButton#GQI:focus, QRadioButton#QSDR:focus { border-color: #a5b4fc; }
QRadioButton#DTI:checked, QRadioButton#GQI:checked, QRadioButton#QSDR:checked { color: #1e3a8a; background-color: #e0e7ff; border-color: #a5b4fc; }
QRadioButton#DTI:disabled, QRadioButton#GQI:disabled, QRadioButton#QSDR:disabled { color: #9a9a9f; }
QStackedWidget#pages QFrame[card="true"] { background-color: #ffffff; border: 1px solid #dddddf; border-top: 4px solid #0ea5e9; border-radius: 9px; }
QFrame#method_group, QFrame#volume_group, QFrame#btable_check_group, QFrame#performance_group { border-top-color: #10b981; }
QFrame#hist_param_group, QFrame#image_group, QFrame#qc_card, QFrame#btable_orient_group, QFrame#groupBox { border-top-color: #f59e0b; }
QFrame#signal_group, QFrame#testing_group { border-top-color: #8b5cf6; }
QFrame#correction_group { border-top-color: #ef4444; }
QFrame#fsl_group { border-top-color: #2563eb; }
QFrame#btable_table_card { border-top-color: #10b981; }
QStackedWidget#pages QPushButton#btable_orient_toggle { color: #2563eb; background-color: transparent; border: 0px; min-height: 0px; padding: 2px 0px; font-weight: bold; text-align: left; }
QStackedWidget#pages QPushButton#btable_orient_toggle:hover { color: #1e40af; }
QStackedWidget#pages QPushButton#zoom_in, QStackedWidget#pages QPushButton#zoom_out { min-height: 0px; padding: 3px; border-radius: 6px; }
QStackedWidget#pages QLabel[cardTitle="true"] { color: #202124; font-weight: bold; background: transparent; border: 0px; padding-bottom: 2px; }
QStackedWidget#pages QFrame[card="true"] QLabel, QStackedWidget#pages QFrame[card="true"] QCheckBox { background: transparent; }
QStackedWidget#pages QFrame[card="true"] QWidget#mask_edit, QStackedWidget#pages QFrame[card="true"] QWidget#qsdr_options, QStackedWidget#pages QFrame[card="true"] QWidget#GQIOption_2, QStackedWidget#pages QFrame[card="true"] QWidget#ODF_metrics, QStackedWidget#pages QFrame[card="true"] QWidget#source_widget { background: transparent; border: 0px; }
QFrame#run_bar QPushButton#change_fib_output { color: #202124; background-color: #ffffff; border: 1px solid #d9d9dc; border-radius: 7px; padding: 4px 8px; }</string>
